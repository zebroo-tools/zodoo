# Installs the postgres client matching POSTGRES_VERSION.
#
# The first RUN sets up pgdg and installs client 17 (needed for libpq-dev).
# The second RUN replaces it with the client of the configured server:
# servers 11-14 (and an unset version) get client 14, a newer client that
# talks to all of them; 15 and later get their own client. Any other value
# fails the build instead of silently falling back to an unrelated client.
# Every other client is purged, so pg_dump/psql in the image can only be the
# matching one.
RUN \
    $(mv /etc/apt/apt.conf.d/01proxy /tmp || true) && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/pgdg.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    postgresql-client-17 && \
    $(mv /tmp/01proxy /etc/apt/apt.conf.d || true)
RUN \
set -x && \
case "$POSTGRES_VERSION" in \
""|11|12|13|14) pg_client=14 ;; \
1[5-9]|[2-9][0-9]) pg_client="$POSTGRES_VERSION" ;; \
*) echo "postgres snippet: unsupported POSTGRES_VERSION '$POSTGRES_VERSION'" >&2; exit 1 ;; \
esac && \
for v in 14 15 16 17 18 19; do \
[ "$v" = "$pg_client" ] || apt-get purge -y postgresql-$v postgresql-client-$v postgresql-contrib-$v || true; \
done && \
#___SNIPPET_APT_INSTALL___ \
postgresql-client-$pg_client
